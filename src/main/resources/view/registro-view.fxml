<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    
<stylesheets>
    <URL value="@/css/dashboard-medico.css" />
</stylesheets>

    <!-- ENCABEZADO Y BARRA DE FILTROS -->
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label styleClass="header-title" text="Dashboard médico - Agenda y citas" />
                
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <padding>
                        <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
                    </padding>
                    <children>
                        <Label text="Médico:" />
                        <ComboBox prefWidth="200.0" promptText="Seleccionar médico..." />
                        
                        <Label text="Fecha:" />
                        <DatePicker prefWidth="140.0" />
                        
                        <Button text="Hoy" />
                        <Button text="Refrescar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- SECCIÓN CENTRAL: TABLA DE AGENDA Y BOTONES -->
    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="0.0" />
            </padding>
            <children>
                <Label styleClass="section-title" text="Agenda del día seleccionado" />
                
                <!-- Tabla principal -->
                <TableView prefHeight="320.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="80.0" text="Hora" />
                        <TableColumn prefWidth="180.0" text="Paciente" />
                        <TableColumn prefWidth="180.0" text="Médico" />
                        <TableColumn prefWidth="140.0" text="Especialidad" />
                        <TableColumn prefWidth="110.0" text="Estado" />
                    </columns>
                    <placeholder>
                        <Label styleClass="placeholder-label" text="Tabla sin contenido" />
                    </placeholder>
                </TableView>

                <!-- Panel de Estado y Acciones de Cita -->
                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="status-label" text="Ninguna cita seleccionada" />
                        
                        <HBox spacing="10.0">
                            <children>
                                <Button disable="true" text="Iniciar consulta" />
                                <Button disable="true" styleClass="btn-success" text="Finalizar y guardar" />
                                <Button disable="true" styleClass="btn-success" text="Agregar receta" />
                                <Button disable="true" styleClass="btn-danger" text="Cancelar cita" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Panel: Agendar nueva cita -->
                <VBox spacing="8.0" styleClass="card-panel">
                    <children>
                        <Label styleClass="section-title" text="Agendar nueva cita (usa el médico y la fecha de arriba)" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Paciente:" />
                                <ComboBox prefWidth="220.0" promptText="Seleccionar paciente..." HBox.hgrow="ALWAYS" />
                                
                                <Label text="Hora libre:" />
                                <ComboBox prefWidth="120.0" promptText="--:--" />
                                
                                <Button styleClass="btn-success" text="Agendar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

    <!-- PANEL LATERAL DERECHO: CITAS PENDIENTES, CONSULTA Y RECETA -->
    <right>
        <VBox prefWidth="320.0" spacing="12.0">
            <padding>
                <Insets bottom="10.0" left="5.0" right="10.0" top="0.0" />
            </padding>
            <children>
                <!-- Citas pendientes -->
                <VBox prefHeight="160.0" spacing="8.0" styleClass="card-panel">
                    <children>
                        <Label styleClass="section-title" text="Citas pendientes" />
                        <ListView prefHeight="110.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <!-- Formulario de Consulta y Receta -->
                <VBox spacing="8.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-title" text="Consulta y receta" />
                        
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Motivo:" />
                                <TextField promptText="Motivo de la consulta" />
                            </children>
                        </VBox>
                        
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Diagnóstico:" />
                                <TextField promptText="Diagnóstico (obligatorio)" />
                            </children>
                        </VBox>
                        
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Observaciones:" />
                                <TextArea prefRowCount="2" promptText="Observaciones" wrapText="true" />
                            </children>
                        </VBox>
                        
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Medicamentos:" />
                                <TextArea prefRowCount="2" promptText="Ej. Ibuprofeno 400mg" wrapText="true" />
                            </children>
                        </VBox>
                        
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Indicaciones:" />
                                <TextArea prefRowCount="2" promptText="Ej. Cada 8 horas por 5 días" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </right>

</BorderPane>